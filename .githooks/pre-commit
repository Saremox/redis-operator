#!/usr/bin/env bash
# Installed via `make install-hooks` (git hooks under .git/hooks aren't
# version controlled, so core.hooksPath points here instead).
#
# Only runs verify-codegen when a commit actually touches the API types or
# go.mod (a k8s.io/api bump changes the CRD schema) - every other commit
# exits immediately without needing controller-gen at all, so this doesn't
# add friction to unrelated work.
set -euo pipefail

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(api/.*\.go|go\.mod)$'; then
	exit 0
fi

if ! command -v controller-gen >/dev/null 2>&1; then
	echo "pre-commit: api/ or go.mod changed, but controller-gen isn't on PATH."
	echo "Install it with: make install-controller-gen"
	exit 1
fi

if ! make verify-codegen; then
	echo ""
	echo "pre-commit: generated DeepCopy code or CRD manifests don't match the API types."
	echo "Review the diff above, then 'git add' the regenerated files and commit again."
	exit 1
fi
