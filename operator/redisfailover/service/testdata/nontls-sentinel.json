  "statefulset": {
    "metadata": {
      "name": "rfr-test",
      "namespace": "testns",
      "labels": {
        "app.kubernetes.io/component": "redis",
        "app.kubernetes.io/name": "test",
        "app.kubernetes.io/part-of": "redis-failover",
        "redisfailovers-role": "slave"
      },
      "ownerReferences": [
        {
          "apiVersion": "",
          "kind": "",
          "name": "sentinel",
          "uid": ""
        }
      ]
    },
    "spec": {
      "replicas": 3,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/component": "redis",
          "app.kubernetes.io/name": "test",
          "app.kubernetes.io/part-of": "redis-failover"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/component": "redis",
            "app.kubernetes.io/name": "test",
            "app.kubernetes.io/part-of": "redis-failover",
            "redisfailovers-role": "slave"
          },
          "annotations": {
            "redisfailovers.databases.spotahome.com/secret-checksum": "6fecf0e151249e80df864e84286b2e91cfe53fbf865480d4aaa36e20ea0e9b1b"
          }
        },
        "spec": {
          "volumes": [
            {
              "name": "redis-config",
              "configMap": {
                "name": "rfr-test"
              }
            },
            {
              "name": "redis-shutdown-config",
              "configMap": {
                "name": "rfr-s-test",
                "defaultMode": 484
              }
            },
            {
              "name": "redis-readiness-config",
              "configMap": {
                "name": "rfr-readiness-test",
                "defaultMode": 484
              }
            },
            {
              "name": "redis-data",
              "emptyDir": {}
            }
          ],
          "initContainers": [
            {
              "name": "rdb-tempfile-cleanup",
              "image": "redis:7.2.12-alpine",
              "command": [
                "sh",
                "-c",
                "find /data -maxdepth 1 -type f -name 'temp-*.rdb' -delete"
              ],
              "resources": {
                "limits": {
                  "cpu": "10m",
                  "memory": "32Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "volumeMounts": [
                {
                  "name": "redis-data",
                  "mountPath": "/data"
                }
              ],
              "imagePullPolicy": "Always",
              "securityContext": {
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "privileged": false,
                "runAsUser": 1000,
                "runAsGroup": 1000,
                "runAsNonRoot": true,
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false
              }
            }
          ],
          "containers": [
            {
              "name": "redis",
              "image": "redis:7.2.12-alpine",
              "command": [
                "redis-server",
                "/redis/redis.conf"
              ],
              "ports": [
                {
                  "name": "redis",
                  "containerPort": 6379,
                  "protocol": "TCP"
                }
              ],
              "env": [
                {
                  "name": "REDIS_ADDR",
                  "value": "redis://127.0.0.1:6379"
                },
                {
                  "name": "REDIS_PORT",
                  "value": "6379"
                },
                {
                  "name": "REDIS_USER",
                  "value": "default"
                }
              ],
              "resources": {},
              "volumeMounts": [
                {
                  "name": "redis-config",
                  "mountPath": "/redis"
                },
                {
                  "name": "redis-shutdown-config",
                  "mountPath": "/redis-shutdown"
                },
                {
                  "name": "redis-readiness-config",
                  "mountPath": "/redis-readiness"
                },
                {
                  "name": "redis-data",
                  "mountPath": "/data"
                }
              ],
              "livenessProbe": {
                "exec": {
                  "command": [
                    "sh",
                    "-c",
                    "t=; command -v timeout \u003e/dev/null 2\u003e\u00261 \u0026\u0026 t=\"timeout 2\"; $t redis-cli -h $(hostname) -p 6379 --user pinger --pass pingpass --no-auth-warning ping | grep -qE '^(PONG|LOADING)'"
                  ]
                },
                "initialDelaySeconds": 30,
                "timeoutSeconds": 5,
                "periodSeconds": 15,
                "failureThreshold": 6
              },
              "readinessProbe": {
                "exec": {
                  "command": [
                    "/bin/sh",
                    "/redis-readiness/ready.sh"
                  ]
                },
                "initialDelaySeconds": 30,
                "timeoutSeconds": 5
              },
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "/redis-shutdown/shutdown.sh"
                    ]
                  }
                }
              },
              "imagePullPolicy": "Always",
              "securityContext": {
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "privileged": false,
                "runAsUser": 1000,
                "runAsGroup": 1000,
                "runAsNonRoot": true,
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false
              }
            },
            {
              "name": "redis-exporter",
              "image": "quay.io/oliver006/redis_exporter:v1.80.0-alpine",
              "ports": [
                {
                  "name": "metrics",
                  "containerPort": 9200,
                  "protocol": "TCP"
                }
              ],
              "env": [
                {
                  "name": "REDIS_ALIAS",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                },
                {
                  "name": "REDIS_ADDR",
                  "value": "redis://127.0.0.1:6379"
                },
                {
                  "name": "REDIS_PORT",
                  "value": "6379"
                },
                {
                  "name": "REDIS_USER",
                  "value": "default"
                },
                {
                  "name": "REDIS_EXPORTER_WEB_LISTEN_ADDRESS",
                  "value": "0.0.0.0:9200"
                }
              ],
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "100Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "50Mi"
                }
              },
              "imagePullPolicy": "Always",
              "securityContext": {
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "privileged": false,
                "runAsUser": 1000,
                "runAsGroup": 1000,
                "runAsNonRoot": true,
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false
              }
            }
          ],
          "terminationGracePeriodSeconds": 30,
          "dnsPolicy": "ClusterFirst",
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsUser": 1000,
            "runAsGroup": 1000,
            "runAsNonRoot": true,
            "fsGroup": 1000,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "affinity": {
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "weight": 100,
                  "podAffinityTerm": {
                    "labelSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/component": "redis",
                        "app.kubernetes.io/name": "test",
                        "app.kubernetes.io/part-of": "redis-failover"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                }
              ]
            }
          },
          "enableServiceLinks": false
        }
      },
      "serviceName": "rfr-test",
      "podManagementPolicy": "Parallel",
      "updateStrategy": {
        "type": "OnDelete"
      }
    },
    "status": {
      "replicas": 0,
      "availableReplicas": 0
    }
  }
}
